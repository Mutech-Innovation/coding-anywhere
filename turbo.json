{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"]
    },
    "@coding-anywhere/daemon#build": { "dependsOn": ["^build"], "outputs": [] },
    "@coding-anywhere/relay#build": { "dependsOn": ["^build"], "outputs": [] },
    "@coding-anywhere/daemon#test": { "outputs": [] },
    "@coding-anywhere/relay#test": { "outputs": [] },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
