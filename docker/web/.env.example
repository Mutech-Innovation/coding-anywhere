# Public DNS name for the web client. Point an A/AAAA record at this host; your
# Traefik cert resolver will then issue a Let's Encrypt cert for it.
CA_WEB_DOMAIN=app.example.com

# These must match your EXISTING Traefik install. Check your Traefik static
# config / compose for the real names.
#
#   CA_TRAEFIK_NETWORK     the Docker network Traefik watches (often "traefik",
#                          "proxy", or "web")
#   CA_TRAEFIK_ENTRYPOINT  the HTTPS entrypoint name (often "websecure" or
#                          "https")
#   CA_TRAEFIK_CERTRESOLVER the ACME resolver name (often "letsencrypt" or
#                          "myresolver")
CA_TRAEFIK_NETWORK=traefik
CA_TRAEFIK_ENTRYPOINT=websecure
CA_TRAEFIK_CERTRESOLVER=letsencrypt
