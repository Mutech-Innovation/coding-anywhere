# Public DNS name pointing at this host. Caddy will request a Let's Encrypt
# cert for this name on first request.
CA_DOMAIN=relay.example.com

# 32+ random bytes, base64-encoded. Used to sign JWTs issued by the relay.
# Generate with: openssl rand -base64 48
CA_RELAY_JWT_SECRET=replace-me-with-openssl-rand-base64-48
